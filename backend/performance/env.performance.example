# Copy to: performance/.env.performance (or run: npm run perf:init)
# Start the API first: npm run dev  (default http://127.0.0.1:5000)
#
# --- Enrollment (perf:enrollment) ---
# Login: POST http://127.0.0.1:5000/api/auth/login  JSON: {"email":"...","password":"..."}
# Use response "token" only (no "Bearer " prefix).
#
COURSE_ID=
STUDENT_ID=
STUDENT_JWT=
#
# --- Quiz (perf:quiz) ---
# Teacher account with at least one published quiz that has questions.
TEACHER_JWT=
#
# --- Events / campaigns (perf:events) ---
FIXED_CAMPAIGN_ID=
TEACHER_OR_ADMIN_JWT=
#
# --- Reports (perf:reports) ---
# Any logged-in user; CATEGORY_ID = ReportCategory _id from DB.
REPORT_USER_JWT=
CATEGORY_ID=
